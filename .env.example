# TimeTagger on Railway — example environment
#
# Only ADMIN_PASSWORD appears on the one-click deploy form (generated
# automatically). Everything else is baked into the wrapper image; the
# TIMETAGGER_* rows below document the values the wrapper sets and the
# knobs you can override as custom service variables after deploy.
# Never commit a real password here — this file is documentation only.

# Password for the "admin" account (generated on deploy).
ADMIN_PASSWORD=your-generated-admin-password

# Advanced: login credentials as "user:bcrypt-hash,user2:hash2".
# Takes precedence over ADMIN_PASSWORD when set. Generate a hash at
# https://timetagger.app/cred — note the "$" characters must NOT be
# escaped in a Railway service variable.
# TIMETAGGER_CREDENTIALS=

# Bind address the server listens on (wrapper sets 0.0.0.0:$PORT).
# TIMETAGGER_BIND=0.0.0.0:8080

# Data directory — the Railway volume. Do not change.
# TIMETAGGER_DATADIR=/data

# Serve the app at the root instead of /timetagger/ (wrapper sets /).
# TIMETAGGER_PATH_PREFIX=/

# Redirect / straight to the app instead of the landing page.
# TIMETAGGER_APP_REDIRECT=true

# Log level: debug, info, warning, error.
# TIMETAGGER_LOG_LEVEL=info
